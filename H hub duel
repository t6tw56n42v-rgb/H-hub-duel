-- Clover Duels Insta Reset: quick character reset with camera hold and safe cleanup.
local InstaResetState = {busy = false, lastTrigger = 0, cameraCFrame = nil, cameraHold = false, thread = nil}
local function triggerInstaReset()
    local now = os.clock()
    if InstaResetState.busy or now - InstaResetState.lastTrigger < 0.75 then return end
    InstaResetState.lastTrigger = now
    InstaResetState.busy = true

    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid then
        InstaResetState.busy = false
        return
    end

    local cam = workspace.CurrentCamera
    if cam then
        InstaResetState.cameraCFrame = cam.CFrame
        InstaResetState.cameraHold = true
    end

    InstaResetState.thread = task.spawn(function()
        local attempts = 0
        local originalHipHeight = humanoid.HipHeight
        local respawning = false
        local completed = false

        while character and character.Parent and humanoid.Parent and humanoid.Health > 0 and attempts < 40 do
            if LP.Character ~= character then
                respawning = true
                break
            end
            pcall(function()
                humanoid.HipHeight = 1e30
                humanoid.AutoRotate = true
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then root.CanCollide = false end
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = false
                    end
                end
            end)
            attempts += 1
            task.wait(0.05)
        end

        if not respawning and character and character.Parent and humanoid.Parent and humanoid.Health > 0 then
            pcall(function() humanoid.Health = 0 end)
            task.wait(0.1)
            completed = (not character.Parent) or humanoid.Health <= 0 or LP.Character ~= character
        else
            completed = respawning or LP.Character ~= character
        end

        if not completed and character and character.Parent and humanoid.Parent then
            pcall(function()
                humanoid.HipHeight = originalHipHeight
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then root.CanCollide = true end
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = true
                    end
                end
            end)
        end

        InstaResetState.cameraHold = false
        InstaResetState.busy = false
        InstaResetState.thread = nil
    end)
end

