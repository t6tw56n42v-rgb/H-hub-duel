local SAMURAI_BG_ASSET = nil
do
    local SAMURAI_BG_FILE = "H_Hub_Purple_Samurai_BG.jpg"
    local SAMURAI_BG_B64 = ""
    local function decodeBase64(data)
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        data = data:gsub("[^" .. alphabet .. "=]", "")
        local bits = data:gsub(".", function(ch)
            if ch == "=" then return "" end
            local value = (alphabet:find(ch, 1, true) or 1) - 1
            local out = ""
            for i = 6, 1, -1 do
                out = out .. (value % 2^i - value % 2^(i-1) > 0 and "1" or "0")
            end
            return out
        end)
        return (bits:gsub("%d%d%d?%d?%d?%d?%d?%d?", function(byte)
            if #byte ~= 8 then return "" end
            local value = 0
            for i = 1, 8 do
                if byte:sub(i, i) == "1" then value = value + 2^(8-i) end
            end
            return string.char(value)
        end))
    end
    pcall(function()
        local assetFn = getcustomasset or getsynasset
        if type(writefile) ~= "function" or type(assetFn) ~= "function" then return end
        local exists = false
        if type(isfile) == "function" then
            local ok, value = pcall(isfile, SAMURAI_BG_FILE)
            exists = ok and value == true
        end
        if not exists then
            local bytes = decodeBase64(SAMURAI_BG_B64)
            if type(bytes) ~= "string" or #bytes == 0 then return end
            writefile(SAMURAI_BG_FILE, bytes)
        end
        local uri = assetFn(SAMURAI_BG_FILE)
        if type(uri) == "string" and uri ~= "" then SAMURAI_BG_ASSET = uri end
    end)
end

